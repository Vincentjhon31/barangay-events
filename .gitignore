# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android signing secrets.
# The trailing * matters: a renamed/backup key like
# "upload-keystore.jks.old-unknown-password" does NOT match a bare "*.jks"
# glob (that requires the name to END in .jks), and this repo is public —
# so a plain `git add -A` would have published a signing key permanently.
*.jks*
*.keystore*
key.properties
.release/

# Firebase service-account keys (private keys — must never be committed;
# google-services.json is fine to commit, this is not the same thing).
*firebase-adminsdk*.json

# Local Supabase CLI state (e.g. which project `supabase link` connected to
# on this machine) — not shared project config, shouldn't be versioned.
supabase/.temp/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Raw source avatar images (1080x1080, ~20MB) — the app only ships the
# resized/compressed copies actually bundled at assets/avatars/.
/PixCons/
